                  </pdfaSchema:valueType>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>Iptc4xmpExt</pdfaSchema:prefix>
                  <pdfaSchema:schema>IPTC Extension</pdfaSchema:schema>
                  <pdfaSchema:property>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>A set of metadata about artwork or an object in the item.</pdfaProperty:description>
                           <pdfaProperty:name>ArtworkOrObject</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag ArtworkOrObjectDetails</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>The location the content of the item was created.</pdfaProperty:description>
                           <pdfaProperty:name>LocationCreated</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag LocationDetails</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>A location the content of the item is about. For photos that is a location shown in the image.</pdfaProperty:description>
                           <pdfaProperty:name>LocationShown</pdfaProperty:name>
                           <pdfaProperty:valueType>Bag LocationDetails</pdfaProperty:valueType>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Both a Registry Item Id and a Registry Organisation Id to record any registration of this item with a registry.</pdfaProperty:description>
                           <pdfaProperty:name>RegistryId</pdfaProperty:name>
                           <pdfaProperty:valueType>RegistryEntryDetails</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:property>
                  <pdfaSchema:valueType>
                     <rdf:Seq>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structured datatype for details about artwork or an object in an image</pdfaType:description>
                           <pdfaType:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaType:namespaceURI>
                           <pdfaType:prefix>Iptc4xmpExt</pdfaType:prefix>
                           <pdfaType:type>ArtworkOrObjectDetails</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structured datatype for details of a location</pdfaType:description>
                           <pdfaType:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaType:namespaceURI>
                           <pdfaType:prefix>Iptc4xmpExt</pdfaType:prefix>
                           <pdfaType:type>LocationDetails</pdfaType:type>
                        </rdf:li>
                        <rdf:li rdf:parseType="Resource">
                           <pdfaType:description>A structured datatype for an entry in a registry, includes the id issued by the registry and the registry's id.</pdfaType:description>
                           <pdfaType:namespaceURI>http://iptc.org/std/Iptc4xmpExt/2008-02-29/</pdfaType:namespaceURI>
                           <pdfaType:prefix>Iptc4xmpExt</pdfaType:prefix>
                           <pdfaType:type>RegistryEntryDetails</pdfaType:type>
                        </rdf:li>
                     </rdf:Seq>
                  </pdfaSchema:valueType>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <pdfaSchema:namespaceURI>http://ns.useplus.org/ldf/xmp/1.0/</pdfaSchema:namespaceURI>
                  <pdfaSchema:prefix>plus</pdfaSchema:prefix>
