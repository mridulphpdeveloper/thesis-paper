                           <pdfaProperty:category>external</pdfaProperty:category>
                           <pdfaProperty:description>Party or parties granting the license to the Licensee.</pdfaProperty:description>
                           <pdfaProperty:name>Licensor</pdfaProperty:name>
                           <pdfaProperty:valueType>Seq LicensorDetail</pdfaProperty:valueType>
                        </rdf:li>
                     </rdf:Seq>
